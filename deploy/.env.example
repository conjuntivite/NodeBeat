# Copie para deploy/.env (ignorado pelo git) e preencha. Nunca commite o .env.

# A URL do Mongo TEM de incluir o nome do banco (/nodebeat) e usar o mesmo usuário
# "nodebeat" e a mesma senha de MONGO_PASSWORD abaixo (o compose cria o usuário root com eles).
NODEBEAT_MONGO_URL=mongodb://nodebeat:<MONGO_PASSWORD>@mongo:27017/nodebeat?authSource=admin
# Mesma senha de REDIS_PASSWORD abaixo (usuário padrão, por isso o ":" antes da senha).
NODEBEAT_REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
# Gere com: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# ATENÇÃO: trocar esta chave inutiliza as senhas de MK já guardadas.
NODEBEAT_SECRET_KEY=
# Host pingado como "referência" (se ele cai, o monitor congela os alertas); ex.: um DNS público
NODEBEAT_REFERENCE_HOST=<HOST_REFERENCIA>
NODEBEAT_WEBHOOK_URL=<URL_DO_WEBHOOK>
NODEBEAT_WEBHOOK_TOKEN=
# IP da VM onde o nginx escuta (80/443)
NODEBEAT_BIND_IP=<IP_DA_VM>
MONGO_PASSWORD=
REDIS_PASSWORD=
# Evite caracteres especiais de URL (@ : / ? #) nas senhas acima, pois entram nas URLs.
