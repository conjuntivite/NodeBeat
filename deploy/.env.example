# Copie para deploy/.env (ignorado pelo git) e preencha. Nunca commite o .env.

# As URLs do Mongo e do Redis são montadas no compose a partir das senhas abaixo.
# Gere com: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# ATENÇÃO: trocar esta chave inutiliza as senhas de MK já guardadas.
NODEBEAT_SECRET_KEY=
# Host pingado como "referência" (se ele cai, o monitor congela os alertas); ex.: um DNS público
NODEBEAT_REFERENCE_HOST=<HOST_REFERENCIA>
NODEBEAT_WEBHOOK_URL=<URL_DO_WEBHOOK>
NODEBEAT_WEBHOOK_TOKEN=
# Redes da sede (CIDRs separados por vírgula, ex.: 10.1.0.0/16); vazio = nenhuma
# Valor real no lugar de: <REDES_DA_SEDE_SEPARADAS_POR_VIRGULA>
NODEBEAT_SEDE_REDES=
# Página "Preparar MK" (script da MK): IP com que o NodeBeat chega na MK pelo túnel e IPs públicos de saída
# da sede (separados por vírgula; todos, se houver load balance), liberados para ping na MK.
# Vazios = a página avisa e não mostra o script.
NODEBEAT_IP_ORIGEM=<IP_ORIGEM>
NODEBEAT_IPS_PUBLICOS_SEDE=<IPS_PUBLICOS_SEDE_SEPARADOS_POR_VIRGULA>
# LANs de MK fora da faixa privada (CIDRs separados por vírgula), aceitas como IP do túnel no cadastro.
# Cada uma também precisa da rota + SNAT do CT (deploy/README.md). Vazio = só faixa privada.
NODEBEAT_REDES_TUNEL_EXTRA=
# IP do host (CT) por onde as MKs enviam o syslog pelo túnel IPsec (UDP 514)
NODEBEAT_SYSLOG_BIND_IP=<IP_NODEBEAT_TUNEL>
# Dias de retenção dos eventos de syslog no Mongo
NODEBEAT_SYSLOG_DIAS=30
# Intervalo (s) do ping dos aparelhos vigiados do mapa de rede
NODEBEAT_MAPA_S=60
# Communities SNMP v2c (só leitura) tentadas nos switches gerenciáveis, separadas por vírgula.
# Segredo: a que responder é guardada cifrada. Vazio = public. Evite $ (quebra a interpolação do .env).
NODEBEAT_SNMP_COMMUNITIES=public
# Intervalo (s) da leitura SNMP dos switches gerenciáveis
NODEBEAT_SWITCH_S=600
# IP da VM onde o nginx escuta (80/443)
NODEBEAT_BIND_IP=<IP_DA_VM>
MONGO_PASSWORD=
REDIS_PASSWORD=
# Gere as senhas acima com: openssl rand -hex 32
# (só hex: caracteres como @ : / ? # % $ quebram as URLs montadas no compose ou a interpolação do .env)
